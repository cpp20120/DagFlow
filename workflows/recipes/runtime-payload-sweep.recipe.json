{
  "kind": "benchmark-matrix",
  "schemaVersion": 1,
  "variants": [
    {
      "name": "baseline",
      "buildDirectory": "../../out/workflow-builds/runtime-pair-baseline",
      "configuration": "Release"
    },
    {
      "name": "candidate",
      "buildDirectory": "../../out/workflow-builds/runtime-pair-candidate",
      "configuration": "Release"
    }
  ],
  "target": "dagflow_runtime_suite",
  "repeats": 3,
  "timeoutSeconds": 120,
  "fixedArguments": [
    "--tasks", "8192", "--repeats", "12", "--warmup", "2",
    "--central-batch", "1024", "--grain", "512", "--idle-us", "2000"
  ],
  "axes": [
    {
      "name": "scenario",
      "flag": "--scenario",
      "values": [
        "local_saturated", "steal_heavy", "external_detached", "external_handles",
        "idle_burst", "nested_spawn", "scope_recursive", "fanout_fanin",
        "deep_dag", "uneven", "graph_reuse", "dag_build_run",
        "graph_tokens_serial", "graph_tokens_parallel", "range_static", "range_ws",
        "range_static_uneven", "range_ws_uneven"
      ]
    },
    {
      "name": "workers",
      "flag": "--workers",
      "values": ["2", "4"]
    },
    {
      "name": "iterations",
      "flag": "--iterations",
      "values": ["0", "16", "256"]
    }
  ],
  "executionOrder": "round-robin",
  "metrics": {
    "source": "stdout",
    "format": "json",
    "fields": [
      {
        "path": "run_p50_us",
        "name": "payload_run_p50",
        "unit": "us",
        "direction": "lower-is-better"
      },
      {
        "path": "payload_tasks_per_second",
        "name": "payload_throughput",
        "unit": "tasks/s",
        "direction": "higher-is-better"
      }
    ]
  }
}
