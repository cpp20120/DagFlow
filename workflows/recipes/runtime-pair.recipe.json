{
  "kind": "benchmark-matrix",
  "schemaVersion": 1,
  "variants": [
    { "name": "baseline", "buildDirectory": "../../out/workflow-builds/runtime-pair-baseline", "configuration": "Release" },
    { "name": "candidate", "buildDirectory": "../../out/workflow-builds/runtime-pair-candidate", "configuration": "Release" }
  ],
  "target": "dagflow_runtime_suite",
  "repeats": 7,
  "timeoutSeconds": 120,
  "fixedArguments": [
    "--tasks", "16384", "--iterations", "0", "--repeats", "48",
    "--warmup", "8", "--central-batch", "1024", "--grain", "2048"
  ],
  "axes": [
    {
      "name": "scenario",
      "flag": "--scenario",
      "values": [
        "graph_tokens_serial", "graph_tokens_parallel", "deep_dag", "fanout_fanin",
        "graph_reuse", "external_detached", "nested_spawn", "range_ws"
      ]
    },
    { "name": "workers", "flag": "--workers", "values": ["1", "4"] }
  ],
  "executionOrder": "round-robin",
  "metrics": {
    "source": "stdout",
    "format": "json",
    "fields": [
      { "path": "run_p50_us", "name": "runtime_p50", "unit": "us", "direction": "lower-is-better" },
      { "path": "payload_tasks_per_second", "name": "runtime_throughput", "unit": "tasks/s", "direction": "higher-is-better" }
    ]
  }
}
