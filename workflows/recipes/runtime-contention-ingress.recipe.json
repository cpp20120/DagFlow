{
  "kind": "benchmark-matrix",
  "schemaVersion": 1,
  "variants": [
    { "name": "baseline", "buildDirectory": "../../out/workflow-builds/runtime-pair-baseline", "configuration": "Release" },
    { "name": "candidate", "buildDirectory": "../../out/workflow-builds/runtime-pair-candidate", "configuration": "Release" }
  ],
  "target": "dagflow_stress_bench",
  "repeats": 5,
  "timeoutSeconds": 120,
  "fixedArguments": [
    "--json", "--workers", "4", "--tasks", "32768", "--iterations", "16",
    "--warmup", "2", "--warmup-ms", "0", "--repeats", "12",
    "--verify", "exact", "--latency", "--sample-stride", "32"
  ],
  "axes": [
    { "name": "scenario", "flag": "--scenario", "values": ["external-contention", "external-batch", "mixed-chaos"] },
    { "name": "producers", "flag": "--producers", "values": ["1", "4"] },
    { "name": "shards", "flag": "--shards", "values": ["1", "4"] }
  ],
  "executionOrder": "round-robin",
  "metrics": {
    "source": "stdout",
    "format": "json",
    "fields": [
      { "path": "run_p50_us", "name": "ingress_run_p50", "unit": "us", "direction": "lower-is-better" },
      { "path": "submission_rate_p50", "name": "ingress_submission_rate", "unit": "tasks/s", "direction": "higher-is-better" },
      { "path": "start_p99_us", "name": "ingress_start_p99", "unit": "us", "direction": "lower-is-better" },
      { "path": "finish_p99_us", "name": "ingress_finish_p99", "unit": "us", "direction": "lower-is-better" }
    ]
  }
}
