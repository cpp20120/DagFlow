{
  "schemaVersion": 2,
  "contexts": {
    "ci": {
      "sourceDirectory": "..",
      "buildDirectory": "../out/build/ci-debug",
      "configurePreset": "ci-debug",
      "configuration": "Debug",
      "mode": "managed",
      "provenancePolicy": "strict"
    },
    "distribution": {
      "sourceDirectory": "..",
      "buildDirectory": "../out/build/distribution",
      "configurePreset": "distribution",
      "configuration": "Release",
      "mode": "managed",
      "provenancePolicy": "strict"
    }
  },
  "nodes": [
    { "id": "build-check.configure", "kind": "configure", "context": "ci", "timeoutSeconds": 1800 },
    { "id": "build-check.prepare", "kind": "invoke", "context": "ci",
      "target": "dagflow_tests", "dependsOn": ["build-check.configure"],
      "timeoutSeconds": 7200 },
    { "id": "build-check.ctest", "kind": "ctest", "context": "ci",
      "labelRegex": "build", "dependsOn": ["build-check.prepare"],
      "timeoutSeconds": 1800 },
    { "id": "package.configure", "kind": "configure", "context": "distribution",
      "timeoutSeconds": 1800 },
    { "id": "package.static", "kind": "build", "context": "distribution",
      "target": "DagFlow_static", "dependsOn": ["package.configure"],
      "timeoutSeconds": 7200 },
    { "id": "package.shared", "kind": "build", "context": "distribution",
      "target": "DagFlow_shared", "dependsOn": ["package.configure"],
      "timeoutSeconds": 7200 },
    { "id": "package.cpack", "kind": "invoke", "context": "distribution",
      "target": "package", "dependsOn": ["package.static", "package.shared"],
      "timeoutSeconds": 7200 }
  ]
}
