{
  "schemaVersion": 2,
  "contexts": {
    "linux-arm64": {
      "sourceDirectory": "..",
      "buildDirectory": "../out/build/linux-arm64",
      "configurePreset": "linux-arm64",
      "configuration": "Release",
      "mode": "managed",
      "provenancePolicy": "strict"
    },
    "windows-x64": {
      "sourceDirectory": "..",
      "buildDirectory": "../out/build/windows-x64-from-linux",
      "configurePreset": "windows-x64-from-linux",
      "configuration": "Release",
      "mode": "managed",
      "provenancePolicy": "strict"
    },
    "android-arm64": {
      "sourceDirectory": "..",
      "buildDirectory": "../out/build/android-arm64",
      "configurePreset": "android-arm64",
      "configuration": "Release",
      "mode": "managed",
      "provenancePolicy": "strict"
    },
    "wasm32": {
      "sourceDirectory": "..",
      "buildDirectory": "../out/build/wasm32-emscripten",
      "configurePreset": "wasm32-emscripten",
      "configuration": "Release",
      "mode": "managed",
      "provenancePolicy": "strict"
    }
  },
  "nodes": [
    { "id": "linux-arm64.configure", "kind": "configure", "context": "linux-arm64",
