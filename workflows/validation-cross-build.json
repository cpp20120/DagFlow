      "timeoutSeconds": 7200 },
    { "id": "android-arm64.configure", "kind": "configure", "context": "android-arm64",
      "timeoutSeconds": 1800 },
    { "id": "android-arm64.build", "kind": "build", "context": "android-arm64",
      "target": "DagFlow_static", "dependsOn": ["android-arm64.configure"],
      "timeoutSeconds": 7200 },
    { "id": "wasm32.configure", "kind": "configure", "context": "wasm32",
      "timeoutSeconds": 1800 },
    { "id": "wasm32.build", "kind": "build", "context": "wasm32",
      "target": "DagFlow_static", "dependsOn": ["wasm32.configure"],
      "timeoutSeconds": 7200 }
  ]
