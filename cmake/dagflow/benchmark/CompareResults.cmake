cmake_minimum_required(VERSION 3.26)
foreach(_side IN ITEMS BASELINE CANDIDATE)
  if(NOT EXISTS "${${_side}}")
    message(FATAL_ERROR "${_side} must name an existing process-harness result.json")
  endif()
  file(READ "${${_side}}" _json)
  string(JSON _status GET "${_json}" status)
  if(NOT _status STREQUAL "passed")
    message(FATAL_ERROR "Cannot compare failed ${_side} result")
  endif()
  string(JSON ${_side}_MEDIAN GET "${_json}" summary median_us)
  string(JSON ${_side}_SCENARIO GET "${_json}" scenario)
  string(JSON ${_side}_ARGS GET "${_json}" args)
endforeach()
if(NOT BASELINE_SCENARIO STREQUAL CANDIDATE_SCENARIO OR NOT BASELINE_ARGS STREQUAL CANDIDATE_ARGS)
  message(FATAL_ERROR "Compare matching scenario names and arguments")
endif()
if(BASELINE_MEDIAN LESS_EQUAL 0)
  message(FATAL_ERROR "Baseline duration is too short to compare")
endif()
math(EXPR _basis_points "(${CANDIDATE_MEDIAN}-${BASELINE_MEDIAN})*10000/${BASELINE_MEDIAN}")
message(STATUS "Median process time: ${BASELINE_MEDIAN} -> ${CANDIDATE_MEDIAN} us; change=${_basis_points} basis points (100 bp = 1%)")
if(DEFINED MAX_REGRESSION_PERCENT)
  if(NOT MAX_REGRESSION_PERCENT MATCHES "^[0-9]+$")
    message(FATAL_ERROR "MAX_REGRESSION_PERCENT must be a nonnegative integer")
  endif()
  math(EXPR _limit "${MAX_REGRESSION_PERCENT}*100")
  if(_basis_points GREATER _limit)
    message(FATAL_ERROR "Process time regression exceeds the requested threshold")
  endif()
endif()
