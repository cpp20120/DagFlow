include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/ControlFlow.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/CompilerCapabilities.cmake")

# Inspect final source lists, including target_sources() calls made after policy
# application. Compiler depfiles do not know that a PGO profile is an input.
function(boilerplate_finalize_profile_dependencies)
  get_property(_targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
  foreach(_target IN LISTS _targets)
    get_target_property(_profile ${_target} BOILERPLATE_PROFILE_INPUT)
    if(_profile)
      get_target_property(_sources ${_target} SOURCES)
      foreach(_source IN LISTS _sources)
        if(_source MATCHES "\\.(cpp|cc|cxx|c)$")
          set_property(SOURCE "${_source}" APPEND PROPERTY OBJECT_DEPENDS "${_profile}")
        endif()
      endforeach()
    endif()
  endforeach()
endfunction()

function(boilerplate_set_output_name target base)
  boilerplate_get_target_setting(${target} ARTIFACT_SUFFIX _suffix)
  set_target_properties(${target} PROPERTIES OUTPUT_NAME "${base}${_suffix}")
endfunction()

function(_boilerplate_validate_target_options target)
  if(COMMAND _boilerplate_validate_cuda)
    _boilerplate_validate_cuda(${target})
  endif()
  _boilerplate_validate_control_flow(${target})
  foreach(_key IN ITEMS LTO_MODE PGO_MODE PGO_PROFILE SANITIZER ENABLE_NATIVE USE_LLD ENABLE_ICF DEBUG_SYMBOLS)
    boilerplate_get_target_setting(${target} ${_key} _${_key})
  endforeach()
  if(NOT _LTO_MODE MATCHES "^(none|thin|full)$")
    message(FATAL_ERROR "Target ${target}: invalid LTO_MODE=${_LTO_MODE}")
  endif()
  if(NOT _PGO_MODE MATCHES "^(none|generate|use)$")
    message(FATAL_ERROR "Target ${target}: invalid PGO_MODE=${_PGO_MODE}")
  endif()
  if(NOT _SANITIZER MATCHES "^(none|address|undefined|address-undefined|thread|leak)$")
    message(FATAL_ERROR "Target ${target}: invalid SANITIZER=${_SANITIZER}")
  endif()
  if(_LTO_MODE STREQUAL "thin" AND (MSVC OR NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang"))
    message(FATAL_ERROR "Target ${target}: ThinLTO requires a GNU-style Clang driver")
  endif()
  if(NOT _SANITIZER STREQUAL "none" AND MSVC)
    message(FATAL_ERROR "Target ${target}: sanitizer policy currently supports GCC/Clang drivers")
  endif()
  if(MSVC AND (NOT _PGO_MODE STREQUAL "none" OR _ENABLE_NATIVE OR _USE_LLD OR _ENABLE_ICF))
    message(FATAL_ERROR "Target ${target}: PGO/native/lld/ICF require a GNU-style GCC/Clang driver")
  endif()
  if(NOT CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang|MSVC")
    if(NOT _LTO_MODE STREQUAL "none" OR NOT _PGO_MODE STREQUAL "none" OR
       NOT _SANITIZER STREQUAL "none" OR _ENABLE_NATIVE)
      message(FATAL_ERROR "Target ${target}: selected policy is unsupported by ${CMAKE_CXX_COMPILER_ID}")
    endif()
  endif()
  if(_ENABLE_ICF AND NOT _USE_LLD)
    message(FATAL_ERROR "Target ${target}: ICF requires lld")
  endif()
  if(_PGO_MODE STREQUAL "use" AND CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    if(NOT _PGO_PROFILE OR NOT EXISTS "${_PGO_PROFILE}")
      message(FATAL_ERROR "Target ${target}: Clang PGO use requires an existing PGO_PROFILE")
    endif()
  endif()
endfunction()

# Apply generic target settings. With no arguments the cache-level project
# defaults are used. POLICIES are composed left-to-right and explicit setting
# keywords override them. Existing targets can use this function directly.
function(boilerplate_apply_optimization target)
  get_property(_keys GLOBAL PROPERTY BOILERPLATE_POLICY_KEYS)
  cmake_parse_arguments(PARSE_ARGV 1 ARG "" "${_keys}" "POLICIES;HOOKS")
  if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES)
    message(FATAL_ERROR
      "boilerplate_apply_optimization(${target}): invalid arguments: ${ARG_UNPARSED_ARGUMENTS};${ARG_KEYWORDS_MISSING_VALUES}")
  endif()

  get_target_property(_applied ${target} BOILERPLATE_OPTIONS_APPLIED)
  if(_applied)
    if(ARGN)
      message(FATAL_ERROR "Target ${target}: policy/options were already applied; later overrides would be ignored")
    endif()
    return()
  endif()

  get_target_property(_configured ${target} BOILERPLATE_POLICY_CONFIGURED)
  set(_explicit FALSE)
  if(ARG_POLICIES OR ARG_HOOKS)
    set(_explicit TRUE)
  endif()
  foreach(_key IN LISTS _keys)
    if(DEFINED ARG_${_key})
      set(_explicit TRUE)
    endif()
  endforeach()
  if(_explicit)
    set(_configure_args)
    if(ARG_POLICIES)
      list(APPEND _configure_args POLICIES ${ARG_POLICIES})
    endif()
    if(ARG_HOOKS)
      list(APPEND _configure_args HOOKS ${ARG_HOOKS})
    endif()
    foreach(_key IN LISTS _keys)
      if(DEFINED ARG_${_key})
        list(APPEND _configure_args ${_key} "${ARG_${_key}}")
      endif()
    endforeach()
    boilerplate_configure_target(${target} ${_configure_args})
  elseif(NOT _configured)
    boilerplate_configure_target(${target})
  endif()

  _boilerplate_validate_target_options(${target})
  _boilerplate_detect_target_capabilities(${target})
  boilerplate_apply_project_options(${target})
  set_property(TARGET ${target} PROPERTY BOILERPLATE_OPTIONS_APPLIED TRUE)

  get_property(_scheduled DIRECTORY PROPERTY BOILERPLATE_PROFILE_FINALIZER)
  if(NOT _scheduled)
    set_property(DIRECTORY PROPERTY BOILERPLATE_PROFILE_FINALIZER TRUE)
    cmake_language(DEFER CALL boilerplate_finalize_profile_dependencies)
  endif()

  foreach(_key IN ITEMS DEBUG_SYMBOLS SANITIZER ENABLE_NATIVE ENABLE_NO_SEMANTIC_INTERPOSITION
      ENABLE_GC_SECTIONS ENABLE_NO_PLT USE_LLD ENABLE_ICF LTO_MODE PGO_MODE PGO_DIR PGO_PROFILE)
    boilerplate_get_target_setting(${target} ${_key} _${_key})
  endforeach()

  get_target_property(_target_type ${target} TYPE)
  if(_target_type MATCHES "^(STATIC_LIBRARY|OBJECT_LIBRARY)$")
    set(_link_scope INTERFACE)
    set(_runtime_link_scope INTERFACE)
  elseif(_target_type STREQUAL "SHARED_LIBRARY")
    set(_link_scope PRIVATE)
    set(_runtime_link_scope PUBLIC)
  else()
    set(_link_scope PRIVATE)
    set(_runtime_link_scope PRIVATE)
  endif()

  if(WIN32 AND _target_type STREQUAL "EXECUTABLE")
    add_custom_command(TARGET ${target} POST_BUILD
      COMMAND ${CMAKE_COMMAND} "-DRUNTIME_FILES=$<TARGET_RUNTIME_DLLS:${target}>"
        "-DDESTINATION=$<TARGET_FILE_DIR:${target}>"
        -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../packaging/CopyRuntimeLibraries.cmake"
      VERBATIM)
  endif()

  if(MSVC)
    if(_DEBUG_SYMBOLS)
      target_compile_options(${target} PRIVATE "$<$<COMPILE_LANGUAGE:CXX>:/Zi>" "$<$<COMPILE_LANGUAGE:CUDA>:-g>")
      if(NOT _target_type STREQUAL "STATIC_LIBRARY")
        target_link_options(${target} PRIVATE /DEBUG)
      endif()
    endif()
    if(_LTO_MODE STREQUAL "full")
      include(CheckIPOSupported)
      check_ipo_supported(RESULT _supported OUTPUT _reason LANGUAGES CXX)
      if(NOT _supported)
        message(FATAL_ERROR "Target ${target}: IPO unavailable: ${_reason}")
      endif()
      set_property(TARGET ${target} PROPERTY INTERPROCEDURAL_OPTIMIZATION TRUE)
    endif()
  elseif(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
    if(_DEBUG_SYMBOLS)
      target_compile_options(${target} PRIVATE -g)
    endif()
    if(NOT _SANITIZER STREQUAL "none")
      if(_SANITIZER STREQUAL "address-undefined")
        set(_sanitizer address,undefined)
      else()
        set(_sanitizer "${_SANITIZER}")
      endif()
      target_compile_options(${target} PRIVATE -fsanitize=${_sanitizer} -fno-omit-frame-pointer)
      target_link_options(${target} ${_runtime_link_scope} -fsanitize=${_sanitizer})
    endif()
    if(_ENABLE_NATIVE)
      if(CMAKE_CROSSCOMPILING)
        message(FATAL_ERROR "Target ${target}: ENABLE_NATIVE cannot use the build host CPU in a cross build; select target CPU flags in the toolchain")
      endif()
      get_target_property(_native_flags ${target} BOILERPLATE_NATIVE_FLAGS)
      target_compile_options(${target} PRIVATE ${_native_flags})
    endif()
    if(_ENABLE_NO_SEMANTIC_INTERPOSITION AND CMAKE_SYSTEM_NAME STREQUAL "Linux")
      target_compile_options(${target} PRIVATE -fno-semantic-interposition)
    endif()
    if(_ENABLE_NO_PLT AND CMAKE_SYSTEM_NAME STREQUAL "Linux")
      target_compile_options(${target} PRIVATE -fno-plt)
    endif()
    if(_ENABLE_GC_SECTIONS)
      target_compile_options(${target} PRIVATE -ffunction-sections -fdata-sections)
      if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        target_link_options(${target} ${_link_scope} LINKER:--gc-sections)
      elseif(APPLE)
        target_link_options(${target} ${_link_scope} LINKER:-dead_strip)
      endif()
    endif()
    if(_USE_LLD)
      target_link_options(${target} ${_link_scope} -fuse-ld=lld)
    endif()
    if(_ENABLE_ICF AND CMAKE_SYSTEM_NAME STREQUAL "Linux")
      target_link_options(${target} ${_link_scope} LINKER:--icf=safe)
    endif()

    if(_LTO_MODE STREQUAL "thin")
      target_compile_options(${target} PRIVATE -flto=thin)
      target_link_options(${target} ${_link_scope} -flto=thin)
    elseif(_LTO_MODE STREQUAL "full")
      if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
        target_compile_options(${target} PRIVATE -flto=full)
        target_link_options(${target} ${_link_scope} -flto=full)
      else()
        target_compile_options(${target} PRIVATE -flto)
        target_link_options(${target} ${_link_scope} -flto)
      endif()
    endif()

    if(_PGO_MODE STREQUAL "generate")
      file(MAKE_DIRECTORY "${_PGO_DIR}")
      if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
        set(_pgo_pattern "${_PGO_DIR}/${target}-%m-%p.profraw")
        target_compile_options(${target} PRIVATE "-fprofile-instr-generate=${_pgo_pattern}")
        target_link_options(${target} ${_link_scope} "-fprofile-instr-generate=${_pgo_pattern}")
      elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
        target_compile_options(${target} PRIVATE "-fprofile-generate=${_PGO_DIR}")
        target_link_options(${target} ${_link_scope} "-fprofile-generate=${_PGO_DIR}")
      endif()
    elseif(_PGO_MODE STREQUAL "use")
      if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
        target_compile_options(${target} PRIVATE "-fprofile-instr-use=${_PGO_PROFILE}")
        set_property(TARGET ${target} PROPERTY BOILERPLATE_PROFILE_INPUT "${_PGO_PROFILE}")
        target_link_options(${target} ${_link_scope} "-fprofile-instr-use=${_PGO_PROFILE}")
      elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
        target_compile_options(${target} PRIVATE "-fprofile-use=${_PGO_DIR}" -fprofile-correction)
        target_link_options(${target} ${_link_scope} "-fprofile-use=${_PGO_DIR}")
      endif()
    endif()
  endif()

  _boilerplate_apply_control_flow(${target})
  boilerplate_apply_policy_hooks(${target})
endfunction()

# Preferred public name; the legacy optimization helper remains compatible.
function(boilerplate_apply_target_policy target)
  boilerplate_apply_optimization(${target} ${ARGN})
endfunction()
