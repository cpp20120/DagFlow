include_guard(GLOBAL)
include(CheckCXXSourceCompiles)

# Probe the driver AND linker; accepting a compiler option alone does not prove
# that the linker plugin or sanitizer/PGO runtime is installed. Cache by flags.
function(_boilerplate_probe_flags output compile_flags link_flags)
  string(SHA256 _key "${CMAKE_CXX_COMPILER};${CMAKE_CXX_COMPILER_VERSION};${CMAKE_CXX_FLAGS};${CMAKE_EXE_LINKER_FLAGS};${compile_flags};${link_flags}")
  set(CMAKE_REQUIRED_FLAGS "${compile_flags}")
  set(CMAKE_REQUIRED_LINK_OPTIONS ${link_flags})
  set(CMAKE_TRY_COMPILE_TARGET_TYPE EXECUTABLE)
  check_cxx_source_compiles("int main() { return 0; }" "BOILERPLATE_CAP_${_key}")
  set(${output} "${BOILERPLATE_CAP_${_key}}" PARENT_SCOPE)
endfunction()

function(_boilerplate_detect_target_capabilities target)
  if(MSVC OR NOT CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
    return()
  endif()
  foreach(_key IN ITEMS USE_LLD ENABLE_ICF LTO_MODE SANITIZER PGO_MODE ENABLE_NATIVE)
    boilerplate_get_target_setting(${target} ${_key} _${_key})
  endforeach()
  set(_compile)
  set(_link)
  if(_USE_LLD)
    list(APPEND _link -fuse-ld=lld)
  endif()
  if(_ENABLE_ICF)
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
      message(FATAL_ERROR "Target ${target}: safe ICF policy is only implemented for ELF/Linux")
    endif()
    list(APPEND _link -Wl,--icf=safe)
  endif()
  if(_ENABLE_NATIVE)
    if(CMAKE_CROSSCOMPILING)
      message(FATAL_ERROR "Target ${target}: ENABLE_NATIVE cannot use the build host CPU in a cross build; select target CPU flags in the toolchain")
    endif()
    if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64|ARM64)$")
      set(_native -mcpu=native)
    else()
      set(_native -march=native -mtune=native)
    endif()
    set_property(TARGET ${target} PROPERTY BOILERPLATE_NATIVE_FLAGS "${_native}")
    list(APPEND _compile ${_native})
  endif()
  if(NOT _SANITIZER STREQUAL "none")
    string(REPLACE "address-undefined" "address,undefined" _san "${_SANITIZER}")
    list(APPEND _compile "-fsanitize=${_san}")
    list(APPEND _link "-fsanitize=${_san}")
  endif()
  if(NOT _LTO_MODE STREQUAL "none")
    if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
      set(_lto "-flto=${_LTO_MODE}")
    else()
      set(_lto -flto)
    endif()
    list(APPEND _compile "${_lto}")
    list(APPEND _link "${_lto}")
  endif()
  if(NOT _PGO_MODE STREQUAL "none")
    # Probe the profiling runtime, without consuming or producing user profiles.
    if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
      set(_pgo -fprofile-instr-generate)
    else()
      set(_pgo -fprofile-generate)
    endif()
    list(APPEND _compile "${_pgo}")
    list(APPEND _link "${_pgo}")
  endif()
  if(NOT _compile AND NOT _link)
    return()
  endif()
  list(JOIN _compile " " _flags)
  _boilerplate_probe_flags(_supported "${_flags}" "${_link}")
  # Clang installations often ship LLD but no LLVM plugin for the system ld.
  # Apple's linker supports its own LTO; try it first, without Linux assumptions.
  if(NOT _supported AND NOT _USE_LLD AND NOT _LTO_MODE STREQUAL "none"
      AND CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    list(APPEND _link -fuse-ld=lld)
    _boilerplate_probe_flags(_supported "${_flags}" "${_link}")
    if(_supported)
      set_property(TARGET ${target} PROPERTY BOILERPLATE_EFFECTIVE_USE_LLD ON)
    endif()
  endif()
  if(NOT _supported)
    message(FATAL_ERROR
      "Target ${target}: compiler/linker capability check failed for '${_flags};${_link}'. "
      "The selected optimization/instrumentation needs a supported driver, linker and runtime. "
      "Use a portable release profile or install the requested toolchain. See CMakeFiles/CMakeConfigureLog.yaml.")
  endif()
endfunction()
