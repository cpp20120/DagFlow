    {
      "name": "lib-aggressive",
      "inherits": "lib-native-full-lto",
      "cacheVariables": {
        "BOILERPLATE_ENABLE_GC_SECTIONS": "ON",
        "BOILERPLATE_ENABLE_NO_PLT": "ON",
        "BOILERPLATE_ENABLE_NO_SEMANTIC_INTERPOSITION": "ON",
        "BOILERPLATE_ENABLE_ICF": "ON"
