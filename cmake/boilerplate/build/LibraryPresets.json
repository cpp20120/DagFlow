        "BOILERPLATE_PROFILE": "native-thinlto",
        "CMAKE_CXX_COMPILER": "clang++",
        "BOILERPLATE_USE_LLD": "ON"
      }
    },
    {
      "name": "lib-native-full-lto",
      "inherits": "lib-base",
      "cacheVariables": {
        "BOILERPLATE_PROFILE": "native-full-lto",
        "CMAKE_CXX_COMPILER": "clang++",
        "BOILERPLATE_USE_LLD": "ON"
      }
    },
    {
      "name": "lib-o3",
      "inherits": "lib-base",
      "cacheVariables": {
        "BOILERPLATE_PROFILE": "o3"
      }
