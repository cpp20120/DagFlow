{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 26,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "lib-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "BOILERPLATE_LIBRARIES_ONLY": "ON",
        "BOILERPLATE_BUILD_TESTS": "ON",
        "BOILERPLATE_BUILD_SHARED": "ON",
        "BOILERPLATE_BUILD_STATIC": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "lib-debug",
      "inherits": "lib-base",
      "cacheVariables": {
        "BOILERPLATE_PROFILE": "debug"
      }
    },
    {
      "name": "lib-relwithdebinfo",
      "inherits": "lib-base",
      "cacheVariables": {
        "BOILERPLATE_PROFILE": "relwithdebinfo"
      }
    },
    {
      "name": "lib-release",
      "inherits": "lib-base",
      "cacheVariables": {
        "BOILERPLATE_PROFILE": "release"
      }
    },
    {
      "name": "lib-lto",
      "inherits": "lib-base",
      "cacheVariables": {
        "BOILERPLATE_PROFILE": "lto",
        "CMAKE_CXX_COMPILER": "clang++",
        "BOILERPLATE_USE_LLD": "ON"
      }
    },
    {
      "name": "lib-full-lto",
      "inherits": "lib-base",
      "cacheVariables": {
        "BOILERPLATE_PROFILE": "full-lto",
        "CMAKE_CXX_COMPILER": "clang++",
        "BOILERPLATE_USE_LLD": "ON"
      }
