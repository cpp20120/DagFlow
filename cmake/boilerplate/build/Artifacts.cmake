include_guard(GLOBAL)

# Artifact roles form a small semantic type system above CMake target TYPE.
# The core registers only roles it owns; upper framework layers may register
# additional roles without making the standalone library slice depend on them.
function(boilerplate_register_artifact_role role)
  cmake_parse_arguments(PARSE_ARGV 1 ARG "LINKABLE" "" "")
  if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES)
    message(FATAL_ERROR "boilerplate_register_artifact_role(${role}): invalid arguments")
  endif()
  string(TOUPPER "${role}" _role)
  if(NOT _role MATCHES "^[A-Z][A-Z0-9_]*$")
    message(FATAL_ERROR "Invalid boilerplate artifact role: ${role}")
  endif()

  get_property(_roles GLOBAL PROPERTY BOILERPLATE_ARTIFACT_ROLES)
  if(_role IN_LIST _roles)
    get_property(_old_linkable GLOBAL PROPERTY "BOILERPLATE_ARTIFACT_ROLE_${_role}_LINKABLE")
    if(ARG_LINKABLE)
      set(_new_linkable TRUE)
    else()
      set(_new_linkable FALSE)
    endif()
    if(NOT "${_old_linkable}" STREQUAL "${_new_linkable}")
      message(FATAL_ERROR
        "Artifact role ${_role} already registered with LINKABLE=${_old_linkable}")
    endif()
    return()
  endif()

  list(APPEND _roles "${_role}")
  set_property(GLOBAL PROPERTY BOILERPLATE_ARTIFACT_ROLES "${_roles}")
  if(ARG_LINKABLE)
    set_property(GLOBAL PROPERTY "BOILERPLATE_ARTIFACT_ROLE_${_role}_LINKABLE" TRUE)
  else()
    set_property(GLOBAL PROPERTY "BOILERPLATE_ARTIFACT_ROLE_${_role}_LINKABLE" FALSE)
  endif()
endfunction()

function(_boilerplate_artifact_role_is_linkable role out_var)
  string(TOUPPER "${role}" _role)
  get_property(_roles GLOBAL PROPERTY BOILERPLATE_ARTIFACT_ROLES)
  if(NOT _role IN_LIST _roles)
    set(${out_var} FALSE PARENT_SCOPE)
    return()
  endif()
  get_property(_linkable GLOBAL PROPERTY "BOILERPLATE_ARTIFACT_ROLE_${_role}_LINKABLE")
  set(${out_var} "${_linkable}" PARENT_SCOPE)
endfunction()

# Roles owned by the standalone core. Runtime/application/host/plugin roles are
# registered by the optional full execution layer.
boilerplate_register_artifact_role(LIBRARY LINKABLE)
boilerplate_register_artifact_role(EXECUTABLE)

function(_boilerplate_real_target target out_var)
  if(NOT TARGET ${target})
    message(FATAL_ERROR "Unknown target: ${target}")
  endif()
  get_target_property(_real ${target} ALIASED_TARGET)
  if(NOT _real)
    set(_real "${target}")
  endif()
  set(${out_var} "${_real}" PARENT_SCOPE)
endfunction()

function(boilerplate_set_artifact_role target role)
  _boilerplate_real_target(${target} _target)
  string(TOUPPER "${role}" _role)
  get_property(_roles GLOBAL PROPERTY BOILERPLATE_ARTIFACT_ROLES)
  if(NOT _role IN_LIST _roles)
    message(FATAL_ERROR
      "Target ${target}: unknown boilerplate artifact role '${role}'. Register the role before using it.")
  endif()
  get_target_property(_old ${_target} BOILERPLATE_ARTIFACT_ROLE)
  if(_old AND NOT _old STREQUAL _role)
    message(FATAL_ERROR "Target ${target}: artifact role already fixed as ${_old}, cannot change to ${_role}")
  endif()
  set_property(TARGET ${_target} PROPERTY BOILERPLATE_ARTIFACT_ROLE "${_role}")
  if(COMMAND boilerplate_register_target)
    boilerplate_register_target(${_target})
  endif()
endfunction()

function(boilerplate_get_artifact_role target out_var)
  _boilerplate_real_target(${target} _target)
  get_target_property(_role ${_target} BOILERPLATE_ARTIFACT_ROLE)
  if(NOT _role)
    set(_role "UNCLASSIFIED")
  endif()
  set(${out_var} "${_role}" PARENT_SCOPE)
endfunction()

function(_boilerplate_require_artifact_role target expected context)
  boilerplate_get_artifact_role(${target} _role)
  if(NOT _role MATCHES "^(${expected})$")
    message(FATAL_ERROR "${context}: target ${target} has role ${_role}; expected ${expected}")
  endif()
endfunction()

function(_boilerplate_append_target_property target property)
  _boilerplate_real_target(${target} _target)
  get_target_property(_values ${_target} ${property})
  if(NOT _values)
    set(_values)
  endif()
  list(APPEND _values ${ARGN})
  if(_values)
    list(REMOVE_DUPLICATES _values)
  endif()
  set_property(TARGET ${_target} PROPERTY ${property} "${_values}")
endfunction()

# High-level helpers validate semantic link edges. Unclassified third-party CMake
# targets are allowed; classified non-linkable roles are rejected. Raw CMake is
# still the explicit escape hatch when a project intentionally leaves the model.
function(_boilerplate_validate_link_dependencies owner)
  foreach(_dependency IN LISTS ARGN)
    if(NOT TARGET ${_dependency})
      continue()
    endif()
    boilerplate_get_artifact_role(${_dependency} _role)
    if(_role STREQUAL "UNCLASSIFIED")
      continue()
    endif()
    _boilerplate_artifact_role_is_linkable(${_role} _linkable)
    if(NOT _linkable)
      message(FATAL_ERROR
        "${owner}: ${_dependency} is a ${_role} artifact and cannot be used as a link-time library")
    endif()
  endforeach()
endfunction()
