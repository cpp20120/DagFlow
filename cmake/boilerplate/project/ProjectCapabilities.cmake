include_guard(GLOBAL)

option(BOILERPLATE_REQUIRE_PROJECT_TOOLS "Fail when an enabled optional project tool is unavailable" OFF)
set(BOILERPLATE_PROJECT_SOURCE_DIRS "src;include;lib;tests;test;examples;bench;cmake" CACHE STRING
  "Source directories scanned by formatting/analysis project workflows")

function(_boilerplate_project_capability_id name output)
  string(MAKE_C_IDENTIFIER "${name}" _id)
  string(TOUPPER "${_id}" _id)
  set(${output} "${_id}" PARENT_SCOPE)
endfunction()

function(boilerplate_project_tool output description)
  cmake_parse_arguments(PARSE_ARGV 2 ARG "" "" "NAMES")
  # Do not reuse a previous lookup (or the legacy shared cache entry): each
  # caller asks for a different tool, including optional tools that are absent.
  set(_tool _tool-NOTFOUND)
  find_program(_tool NAMES ${ARG_NAMES} NO_CACHE NO_CMAKE_FIND_ROOT_PATH)
  if(NOT _tool AND BOILERPLATE_REQUIRE_PROJECT_TOOLS)
    message(FATAL_ERROR "${description} capability requires one of: ${ARG_NAMES}")
  elseif(NOT _tool)
    message(STATUS "Boilerplate: ${description} unavailable (${ARG_NAMES}); related target omitted")
  endif()
  set(${output} "${_tool}" PARENT_SCOPE)
endfunction()

function(boilerplate_collect_project_sources output)
  cmake_parse_arguments(PARSE_ARGV 1 ARG "CMAKE" "" "EXTENSIONS")
  if(NOT ARG_EXTENSIONS)
    set(ARG_EXTENSIONS c cc cpp cxx h hh hpp hxx inl ipp)
  endif()
  set(_files)
  set(_scan_roots)
  foreach(_entry IN LISTS BOILERPLATE_PROJECT_SOURCE_DIRS)
    if(IS_ABSOLUTE "${_entry}")
      set(_root "${_entry}")
    else()
      set(_root "${CMAKE_SOURCE_DIR}/${_entry}")
    endif()
    if(NOT EXISTS "${_root}")
      continue()
    endif()
    get_filename_component(_root "${_root}" REALPATH)
    list(APPEND _scan_roots "${_root}")
    set(_patterns)
    if(ARG_CMAKE)
      list(APPEND _patterns "${_root}/CMakeLists.txt" "${_root}/*.cmake")
    else()
      foreach(_ext IN LISTS ARG_EXTENSIONS)
        list(APPEND _patterns "${_root}/*.${_ext}")
      endforeach()
    endif()
    file(GLOB_RECURSE _found CONFIGURE_DEPENDS ${_patterns})
    list(APPEND _files ${_found})
  endforeach()
  if(ARG_CMAKE AND EXISTS "${CMAKE_SOURCE_DIR}/CMakeLists.txt")
    list(APPEND _files "${CMAKE_SOURCE_DIR}/CMakeLists.txt")
  endif()

  # Components may live outside the conventional src/include/lib roots. Scan
  # their registered source trees as well without requiring a giant monorepo to
  # duplicate every component path in BOILERPLATE_PROJECT_SOURCE_DIRS.
  if(COMMAND boilerplate_list_components)
    boilerplate_list_components(_components)
    foreach(_component IN LISTS _components)
      boilerplate_component_property("${_component}" SOURCE_DIR _component_root)
      if(NOT EXISTS "${_component_root}")
        continue()
      endif()
      set(_covered FALSE)
      foreach(_scan_root IN LISTS _scan_roots)
        file(RELATIVE_PATH _component_relative "${_scan_root}" "${_component_root}")
        if(NOT _component_relative MATCHES "^[.][.](/|$)" AND NOT IS_ABSOLUTE "${_component_relative}")
          set(_covered TRUE)
          break()
        endif()
      endforeach()
      if(_covered)
        continue()
      endif()
      set(_component_patterns)
      if(ARG_CMAKE)
        list(APPEND _component_patterns
          "${_component_root}/CMakeLists.txt" "${_component_root}/*.cmake")
      else()
        foreach(_ext IN LISTS ARG_EXTENSIONS)
          list(APPEND _component_patterns "${_component_root}/*.${_ext}")
        endforeach()
      endif()
      file(GLOB_RECURSE _component_files CONFIGURE_DEPENDS ${_component_patterns})
      list(APPEND _files ${_component_files})
      # Treat this component as covered for later duplicate/nested component roots.
      list(APPEND _scan_roots "${_component_root}")
    endforeach()
  endif()
  if(_files)
    list(REMOVE_DUPLICATES _files)
    list(SORT _files)
  endif()
  set(${output} "${_files}" PARENT_SCOPE)
endfunction()

function(boilerplate_collect_targets directory output)
  get_property(_targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  get_property(_subdirs DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(_subdir IN LISTS _subdirs)
    boilerplate_collect_targets("${_subdir}" _child_targets)
    list(APPEND _targets ${_child_targets})
  endforeach()
  if(_targets)
    list(REMOVE_DUPLICATES _targets)
  endif()
  set(${output} "${_targets}" PARENT_SCOPE)
endfunction()

# Collect the complete CMake target graph, including raw CMake escape-hatch
# targets. During finalization the graph is frozen, so cache the recursive walk
# and let analysis/diagnostics share one traversal even in a large workspace.
function(boilerplate_collect_project_targets output)
  get_property(_frozen GLOBAL PROPERTY BOILERPLATE_PROJECT_GRAPH_FROZEN)
  if(_frozen)
    get_property(_cached_set GLOBAL PROPERTY BOILERPLATE_PROJECT_TARGETS_CACHE SET)
    if(_cached_set)
      get_property(_cached GLOBAL PROPERTY BOILERPLATE_PROJECT_TARGETS_CACHE)
      set(${output} "${_cached}" PARENT_SCOPE)
      return()
    endif()
  endif()
  boilerplate_collect_targets("${CMAKE_SOURCE_DIR}" _targets)
  if(_targets)
    list(REMOVE_DUPLICATES _targets)
  endif()
  if(_frozen)
    set_property(GLOBAL PROPERTY BOILERPLATE_PROJECT_TARGETS_CACHE "${_targets}")
  endif()
  set(${output} "${_targets}" PARENT_SCOPE)
endfunction()

function(boilerplate_define_project_capability name)
  cmake_parse_arguments(PARSE_ARGV 1 ARG "" "" "INHERITS;CONFIGURE_HOOKS;FINALIZE_HOOKS")
  if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES)
    message(FATAL_ERROR "boilerplate_define_project_capability(${name}): invalid arguments")
  endif()
  _boilerplate_project_capability_id("${name}" _id)
  get_property(_defined GLOBAL PROPERTY "BOILERPLATE_PROJECT_CAP_${_id}_DEFINED")
  if(_defined)
    message(FATAL_ERROR "Project capability '${name}' is already defined")
  endif()

  set(_configure)
  set(_finalize)
  set(_closure)
  foreach(_parent IN LISTS ARG_INHERITS)
    _boilerplate_project_capability_id("${_parent}" _parent_id)
    get_property(_parent_defined GLOBAL PROPERTY "BOILERPLATE_PROJECT_CAP_${_parent_id}_DEFINED")
    if(NOT _parent_defined)
      message(FATAL_ERROR "Project capability '${name}' inherits unknown capability '${_parent}'")
    endif()
    get_property(_parent_configure GLOBAL PROPERTY "BOILERPLATE_PROJECT_CAP_${_parent_id}_CONFIGURE_HOOKS")
    get_property(_parent_finalize GLOBAL PROPERTY "BOILERPLATE_PROJECT_CAP_${_parent_id}_FINALIZE_HOOKS")
    get_property(_parent_closure GLOBAL PROPERTY "BOILERPLATE_PROJECT_CAP_${_parent_id}_CLOSURE")
    list(APPEND _configure ${_parent_configure})
    list(APPEND _finalize ${_parent_finalize})
    list(APPEND _closure ${_parent_closure})
  endforeach()
  list(APPEND _configure ${ARG_CONFIGURE_HOOKS})
  list(APPEND _finalize ${ARG_FINALIZE_HOOKS})
  list(APPEND _closure "${name}")
  if(_configure)
    list(REMOVE_DUPLICATES _configure)
  endif()
  if(_finalize)
    list(REMOVE_DUPLICATES _finalize)
  endif()
  if(_closure)
    list(REMOVE_DUPLICATES _closure)
  endif()
  set_property(GLOBAL PROPERTY "BOILERPLATE_PROJECT_CAP_${_id}_CONFIGURE_HOOKS" "${_configure}")
  set_property(GLOBAL PROPERTY "BOILERPLATE_PROJECT_CAP_${_id}_FINALIZE_HOOKS" "${_finalize}")
  set_property(GLOBAL PROPERTY "BOILERPLATE_PROJECT_CAP_${_id}_CLOSURE" "${_closure}")
  set_property(GLOBAL PROPERTY "BOILERPLATE_PROJECT_CAP_${_id}_DEFINED" TRUE)
  set_property(GLOBAL APPEND PROPERTY BOILERPLATE_DEFINED_PROJECT_CAPABILITIES "${name}")
endfunction()

function(_boilerplate_project_configure)
  cmake_parse_arguments(PARSE_ARGV 0 ARG "" "MODE" "CAPABILITIES;TOP_LEVEL_CAPABILITIES;EMBEDDED_CAPABILITIES")
  if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES)
    message(FATAL_ERROR "boilerplate_project: invalid arguments: ${ARG_UNPARSED_ARGUMENTS};${ARG_KEYWORDS_MISSING_VALUES}")
  endif()
  get_property(_configured GLOBAL PROPERTY BOILERPLATE_PROJECT_CONFIGURED)
  if(_configured)
    message(FATAL_ERROR "boilerplate_project() may only be configured once per CMake build")
  endif()

  if(NOT ARG_MODE OR ARG_MODE STREQUAL "auto")
    if(PROJECT_IS_TOP_LEVEL)
      set(ARG_MODE top-level)
    else()
      set(ARG_MODE embedded)
    endif()
  endif()
  if(NOT ARG_MODE MATCHES "^(top-level|embedded)$")
    message(FATAL_ERROR "boilerplate_project MODE must be auto, top-level, or embedded")
  endif()

  set(_caps ${ARG_CAPABILITIES})
  if(ARG_MODE STREQUAL "top-level")
    list(APPEND _caps ${ARG_TOP_LEVEL_CAPABILITIES})
  else()
    list(APPEND _caps ${ARG_EMBEDDED_CAPABILITIES})
  endif()
  if(NOT _caps)
    set(_caps project-minimal)
  endif()
  list(REMOVE_DUPLICATES _caps)

  set(_configure_hooks)
  set(_finalize_hooks)
  set(_expanded_caps)
  foreach(_cap IN LISTS _caps)
    _boilerplate_project_capability_id("${_cap}" _id)
    get_property(_defined GLOBAL PROPERTY "BOILERPLATE_PROJECT_CAP_${_id}_DEFINED")
    if(NOT _defined)
      get_property(_known GLOBAL PROPERTY BOILERPLATE_DEFINED_PROJECT_CAPABILITIES)
      message(FATAL_ERROR "Unknown project capability '${_cap}'. Defined: ${_known}")
    endif()
    get_property(_c GLOBAL PROPERTY "BOILERPLATE_PROJECT_CAP_${_id}_CONFIGURE_HOOKS")
    get_property(_f GLOBAL PROPERTY "BOILERPLATE_PROJECT_CAP_${_id}_FINALIZE_HOOKS")
    get_property(_closure GLOBAL PROPERTY "BOILERPLATE_PROJECT_CAP_${_id}_CLOSURE")
    list(APPEND _configure_hooks ${_c})
    list(APPEND _finalize_hooks ${_f})
    list(APPEND _expanded_caps ${_closure})
  endforeach()
  if(_configure_hooks)
    list(REMOVE_DUPLICATES _configure_hooks)
  endif()
  if(_finalize_hooks)
    list(REMOVE_DUPLICATES _finalize_hooks)
  endif()
  if(_expanded_caps)
    list(REMOVE_DUPLICATES _expanded_caps)
  endif()

  set_property(GLOBAL PROPERTY BOILERPLATE_PROJECT_MODE "${ARG_MODE}")
  set_property(GLOBAL PROPERTY BOILERPLATE_ACTIVE_PROJECT_CAPABILITIES "${_caps}")
  set_property(GLOBAL PROPERTY BOILERPLATE_ACTIVE_PROJECT_CAPABILITIES_EXPANDED "${_expanded_caps}")
  set_property(GLOBAL PROPERTY BOILERPLATE_PROJECT_FINALIZE_HOOKS "${_finalize_hooks}")
  set_property(GLOBAL PROPERTY BOILERPLATE_PROJECT_CONFIGURED TRUE)
  foreach(_hook IN LISTS _configure_hooks)
    if(NOT COMMAND ${_hook})
      message(FATAL_ERROR "Project capability configure hook '${_hook}' is not a CMake command")
    endif()
    cmake_language(CALL ${_hook})
  endforeach()
  message(STATUS "Boilerplate project: mode=${ARG_MODE}, capabilities=${_caps}")
endfunction()

macro(boilerplate_project)
  _boilerplate_project_configure(${ARGV})
  # enable_language() must run in the caller's directory scope. Compiler rules
  # created inside a configure-hook function disappear when it returns.
  get_property(_boilerplate_project_languages GLOBAL PROPERTY BOILERPLATE_PROJECT_LANGUAGES)
  foreach(_boilerplate_project_language IN LISTS _boilerplate_project_languages)
    enable_language(${_boilerplate_project_language})
  endforeach()
  unset(_boilerplate_project_language)
  unset(_boilerplate_project_languages)
endmacro()

function(boilerplate_finalize_project)
  get_property(_configured GLOBAL PROPERTY BOILERPLATE_PROJECT_CONFIGURED)
  if(NOT _configured)
    return()
  endif()
  get_property(_finalized GLOBAL PROPERTY BOILERPLATE_PROJECT_FINALIZED)
  if(_finalized)
    return()
  endif()
  # From this point the real project/component target graph is immutable. Finalize
  # hooks may add workflow/utility targets, but artifact constructors are no longer
  # allowed to mutate the semantic graph.
  set_property(GLOBAL PROPERTY BOILERPLATE_PROJECT_GRAPH_FROZEN TRUE)
  get_property(_hooks GLOBAL PROPERTY BOILERPLATE_PROJECT_FINALIZE_HOOKS)
  foreach(_hook IN LISTS _hooks)
    if(NOT COMMAND ${_hook})
      message(FATAL_ERROR "Project capability finalize hook '${_hook}' is not a CMake command")
    endif()
    cmake_language(CALL ${_hook})
  endforeach()
  set_property(GLOBAL PROPERTY BOILERPLATE_PROJECT_FINALIZED TRUE)
endfunction()

function(boilerplate_project_has_capability name output)
  get_property(_expanded GLOBAL PROPERTY BOILERPLATE_ACTIVE_PROJECT_CAPABILITIES_EXPANDED)
  if(name IN_LIST _expanded)
    set(${output} TRUE PARENT_SCOPE)
  else()
    set(${output} FALSE PARENT_SCOPE)
  endif()
endfunction()

function(boilerplate_list_project_capabilities output)
  get_property(_caps GLOBAL PROPERTY BOILERPLATE_DEFINED_PROJECT_CAPABILITIES)
  set(${output} "${_caps}" PARENT_SCOPE)
endfunction()

