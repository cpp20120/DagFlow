include_guard(GLOBAL)
set(BOILERPLATE_RUN_REPEATS 5 CACHE STRING "Process harness measured repetitions")
set(BOILERPLATE_RUN_WARMUP 1 CACHE STRING "Process harness warmup invocations")
set(BOILERPLATE_RUN_TIMEOUT 60 CACHE STRING "Per-process timeout in seconds")
set(BOILERPLATE_RESULTS_DIR "${CMAKE_BINARY_DIR}/results" CACHE PATH "Harness result root")
set(BOILERPLATE_COMMAND_PREFIX "" CACHE STRING "Optional command prefix as a list, e.g. taskset;-c;2")

# Serialize CMake values without invoking a shell or interpolating their contents.
function(boilerplate_append_setting output name value)
  set(_equals "==")
  while("${value}" MATCHES "]${_equals}]")
    string(APPEND _equals "=")
  endwhile()
  set(${output} "${${output}}set(${name} [${_equals}[${value}]${_equals}])\n" PARENT_SCOPE)
endfunction()

function(boilerplate_register_check name target)
  cmake_parse_arguments(PARSE_ARGV 2 ARG "" "TIMEOUT;WORKING_DIRECTORY" "ARGS;ENVIRONMENT;LABELS")
  if(ARG_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "Invalid check arguments for ${name}")
  endif()
  if(NOT BUILD_TESTING)
    return()
  endif()
  if(NOT ARG_TIMEOUT)
    set(ARG_TIMEOUT 30)
  endif()
  add_test(NAME ${name} COMMAND ${target} ${ARG_ARGS})
  boilerplate_target_execution(${target} _runnable _emulator)
  if(NOT _runnable)
    set_tests_properties(${name} PROPERTIES DISABLED TRUE)
    message(STATUS "Cross test ${name} disabled: set CROSSCOMPILING_EMULATOR on ${target} to execute it")
  endif()
  set_tests_properties(${name} PROPERTIES TIMEOUT "${ARG_TIMEOUT}" LABELS "${ARG_LABELS}")
  if(ARG_ENVIRONMENT)
    set_tests_properties(${name} PROPERTIES ENVIRONMENT "${ARG_ENVIRONMENT}")
  endif()
  if(ARG_WORKING_DIRECTORY)
    set_tests_properties(${name} PROPERTIES WORKING_DIRECTORY "${ARG_WORKING_DIRECTORY}")
  endif()
  if(NOT TARGET boilerplate_tests)
    add_custom_target(boilerplate_tests)
    add_custom_target(boilerplate_check
      COMMAND ${CMAKE_CTEST_COMMAND} --test-dir "${CMAKE_BINARY_DIR}" -C "$<CONFIG>" --output-on-failure
      DEPENDS boilerplate_tests USES_TERMINAL VERBATIM)
  endif()
  add_dependencies(boilerplate_tests ${target})
endfunction()

function(boilerplate_add_scenario name)
  cmake_parse_arguments(PARSE_ARGV 1 ARG "SMOKE;PGO" "TARGET;GROUP;TIMEOUT;REPEATS;WARMUP;WORKING_DIRECTORY"
    "ARGS;SMOKE_ARGS;PGO_ARGS;ENVIRONMENT;LABELS;COMMAND_PREFIX")
  if(ARG_UNPARSED_ARGUMENTS OR NOT TARGET "${ARG_TARGET}")
    message(FATAL_ERROR "Invalid scenario ${name}: TARGET must exist")
  endif()
  get_target_property(_type ${ARG_TARGET} TYPE)
  if(NOT _type STREQUAL "EXECUTABLE")
    message(FATAL_ERROR "Scenario ${name} needs an executable target")
  endif()
  if(NOT name MATCHES "^[a-zA-Z0-9_-]+$")
    message(FATAL_ERROR "Scenario names must be filesystem-safe identifiers")
  endif()
  if(NOT ARG_GROUP)
    set(ARG_GROUP default)
  endif()
  if(NOT ARG_GROUP MATCHES "^[a-zA-Z0-9_-]+$")
    message(FATAL_ERROR "Invalid scenario group")
  endif()
  foreach(_field IN ITEMS REPEATS WARMUP TIMEOUT)
    if(NOT DEFINED ARG_${_field})
      set(ARG_${_field} "${BOILERPLATE_RUN_${_field}}")
    endif()
  endforeach()
  if(NOT ARG_REPEATS MATCHES "^[1-9][0-9]*$" OR NOT ARG_WARMUP MATCHES "^[0-9]+$"
      OR NOT ARG_TIMEOUT MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "Scenario repeat/timeout must be positive integers; warmup nonnegative")
  endif()
  if(NOT ARG_WORKING_DIRECTORY)
    set(ARG_WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}")
  endif()
  if(NOT ARG_COMMAND_PREFIX)
    set(ARG_COMMAND_PREFIX "${BOILERPLATE_COMMAND_PREFIX}")
  endif()
  string(TOUPPER "${name}" _key)
  set(BOILERPLATE_${_key}_ARGS "${ARG_ARGS}" CACHE STRING "Arguments for run_${name} (CMake list)")
  set(_content)
  boilerplate_append_setting(_content EXECUTABLE "$<TARGET_FILE:${ARG_TARGET}>")
  boilerplate_target_execution(${ARG_TARGET} _runnable _emulator)
  boilerplate_append_setting(_content EXECUTION_BLOCKED "$<NOT:$<BOOL:${_runnable}>>")
  boilerplate_append_setting(_content EMULATOR "${_emulator}")
  boilerplate_append_setting(_content ARGS "${BOILERPLATE_${_key}_ARGS}")
  foreach(_field IN ITEMS REPEATS WARMUP TIMEOUT WORKING_DIRECTORY ENVIRONMENT COMMAND_PREFIX)
    boilerplate_append_setting(_content ${_field} "${ARG_${_field}}")
  endforeach()
  boilerplate_append_setting(_content SCENARIO "${name}")
  boilerplate_append_setting(_content RESULT_ROOT "${BOILERPLATE_RESULTS_DIR}/$<CONFIG>/${name}")
  boilerplate_append_setting(_content PROFILE "${BOILERPLATE_PROFILE}")
  boilerplate_append_setting(_content CONFIG "$<CONFIG>")
  boilerplate_append_setting(_content COMPILER "${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}")
  boilerplate_append_setting(_content SOURCE_DIR "${CMAKE_SOURCE_DIR}")
  set(_knobs "CMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}")
  foreach(_setting IN ITEMS LTO_MODE PGO_MODE SANITIZER CFI CFI_DIAGNOSTICS WINDOWS_CFG ENABLE_NATIVE ENABLE_NO_PLT
      ENABLE_NO_SEMANTIC_INTERPOSITION ENABLE_GC_SECTIONS ENABLE_ICF USE_LLD FRAME_POINTERS REPRODUCIBLE HARDENING COVERAGE CXX_STANDARD)
    boilerplate_get_target_setting(${ARG_TARGET} ${_setting} _value)
    list(APPEND _knobs "${_setting}=${_value}")
  endforeach()
  if(DEFINED BOILERPLATE_ALLOCATOR)
    list(APPEND _knobs "BOILERPLATE_ALLOCATOR=${BOILERPLATE_ALLOCATOR}")
  endif()
  boilerplate_append_setting(_content BUILD_KNOBS "${_knobs}")
  set(_config "${CMAKE_CURRENT_BINARY_DIR}/scenarios/$<CONFIG>/${name}.cmake")
  file(GENERATE OUTPUT "${_config}" CONTENT "${_content}")
  add_custom_target(run_${name}
    COMMAND ${CMAKE_COMMAND} "-DRUN_CONFIG=${_config}" -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/RunWorkload.cmake"
    DEPENDS ${ARG_TARGET} USES_TERMINAL VERBATIM)
  set_property(GLOBAL APPEND PROPERTY BOILERPLATE_SCENARIO_GROUPS "${ARG_GROUP}")
  set_property(GLOBAL APPEND PROPERTY BOILERPLATE_GROUP_CONFIGS_${ARG_GROUP} "${_config}")
  set_property(GLOBAL APPEND PROPERTY BOILERPLATE_GROUP_TARGETS_${ARG_GROUP} "${ARG_TARGET}")
  get_property(_scheduled GLOBAL PROPERTY BOILERPLATE_GROUPS_SCHEDULED)
  if(NOT _scheduled)
    set_property(GLOBAL PROPERTY BOILERPLATE_GROUPS_SCHEDULED TRUE)
    cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL boilerplate_finalize_groups)
  endif()
  if(ARG_SMOKE)
    boilerplate_register_check(${name}_smoke ${ARG_TARGET} ARGS ${ARG_SMOKE_ARGS}
      TIMEOUT "${ARG_TIMEOUT}" WORKING_DIRECTORY "${ARG_WORKING_DIRECTORY}"
      ENVIRONMENT ${ARG_ENVIRONMENT} LABELS smoke scenario ${ARG_GROUP} ${ARG_LABELS})
  endif()
  if(ARG_PGO)
    set(_boilerplate_pgo_environment "${ARG_ENVIRONMENT}")
    set(_boilerplate_pgo_workdir "${ARG_WORKING_DIRECTORY}")
    set(_boilerplate_pgo_timeout "${ARG_TIMEOUT}")
    boilerplate_pgo_workload(${ARG_TARGET} ${ARG_PGO_ARGS})
  endif()
endfunction()

function(boilerplate_finalize_groups)
  get_property(_groups GLOBAL PROPERTY BOILERPLATE_SCENARIO_GROUPS)
  list(REMOVE_DUPLICATES _groups)
  foreach(_group IN LISTS _groups)
    get_property(_configs GLOBAL PROPERTY BOILERPLATE_GROUP_CONFIGS_${_group})
    get_property(_targets GLOBAL PROPERTY BOILERPLATE_GROUP_TARGETS_${_group})
    set(_commands)
    foreach(_config IN LISTS _configs)
      list(APPEND _commands COMMAND ${CMAKE_COMMAND} "-DRUN_CONFIG=${_config}"
        -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/RunWorkload.cmake")
    endforeach()
    add_custom_target(run_group_${_group} ${_commands} DEPENDS ${_targets} USES_TERMINAL VERBATIM)
  endforeach()
endfunction()
