{
  "defaults": {
    "args": ["--scenario", "noop"],
    "env": {"HARNESS_MODE": "benchmark"},
    "metadata": {"scenario": "noop"}
  },
  "groups": {
    "smoke": ["single-worker"],
    "scaling": ["single-worker", "four-workers"]
  },
  "cases": [
    {
      "name": "single-worker",
      "args": ["--workers", "1"],
      "cpu_count": 1,
      "metadata": {"workers": 1}
    },
    {
      "name": "four-workers",
      "args": ["--workers", "4"],
      "cpu_count": 4,
      "metadata": {"workers": 4}
    }
  ]
}
