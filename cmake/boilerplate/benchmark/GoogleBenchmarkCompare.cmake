cmake_minimum_required(VERSION 3.26)
foreach(_file IN ITEMS BASELINE CANDIDATE)
  if(NOT EXISTS "${${_file}}")
    message(FATAL_ERROR "${_file} must name an existing Google Benchmark JSON file")
  endif()
endforeach()
if(NOT DEFINED MAX_REGRESSION_PERCENT)
  set(MAX_REGRESSION_PERCENT 0)
endif()
if(NOT MAX_REGRESSION_PERCENT MATCHES "^[0-9]+([.][0-9]+)?$")
  message(FATAL_ERROR "MAX_REGRESSION_PERCENT must be nonnegative")
endif()
file(READ "${BASELINE}" _base)
file(READ "${CANDIDATE}" _cand)
function(_scale_decimal out value)
  string(FIND "${value}" "." _dot)
  if(_dot LESS 0)
    set(_whole "${value}")
    set(_frac "")
  else()
    string(SUBSTRING "${value}" 0 ${_dot} _whole)
    math(EXPR _after "${_dot}+1")
    string(SUBSTRING "${value}" ${_after} -1 _frac)
  endif()
  string(SUBSTRING "${_frac}000000" 0 6 _frac6)
  math(EXPR _scaled "${_whole}*1000000+${_frac6}")
  set(${out} "${_scaled}" PARENT_SCOPE)
endfunction()

string(JSON _bn LENGTH "${_base}" benchmarks)
string(JSON _cn LENGTH "${_cand}" benchmarks)

# Use aggregate median when Google Benchmark emitted repetitions, otherwise use
# the ordinary row. Comparisons are fixed-point (ppm) because CMake math is
# intentionally integer-only.
function(_collect prefix json count)
  math(EXPR _last "${count}-1")
  foreach(_i RANGE 0 ${_last})
    string(JSON _name GET "${json}" benchmarks ${_i} name)
    string(JSON _agg ERROR_VARIABLE _ae GET "${json}" benchmarks ${_i} aggregate_name)
    if(NOT _ae AND NOT _agg STREQUAL "median")
      continue()
    endif()
    string(JSON _time ERROR_VARIABLE _te GET "${json}" benchmarks ${_i} real_time)
    if(_te)
      string(JSON _time GET "${json}" benchmarks ${_i} cpu_time)
    endif()
    if(NOT _time MATCHES "^[0-9]+([.][0-9]+)?$")
      continue()
    endif()
    _scale_decimal(_scaled "${_time}")
    string(MAKE_C_IDENTIFIER "${_name}" _key)
    set(${prefix}_${_key}_NAME "${_name}" PARENT_SCOPE)
    set(${prefix}_${_key}_TIME "${_scaled}" PARENT_SCOPE)
    set(${prefix}_KEYS "${${prefix}_KEYS};${_key}" PARENT_SCOPE)
  endforeach()
endfunction()
set(B_KEYS)
set(C_KEYS)
_collect(B "${_base}" ${_bn})
_collect(C "${_cand}" ${_cn})
list(REMOVE_DUPLICATES B_KEYS)
list(REMOVE_DUPLICATES C_KEYS)
set(_failed FALSE)
foreach(_key IN LISTS B_KEYS)
  if(NOT DEFINED C_${_key}_TIME)
    continue()
  endif()
  set(_b "${B_${_key}_TIME}")
  set(_c "${C_${_key}_TIME}")
  if(_b LESS_EQUAL 0)
    continue()
  endif()
  math(EXPR _ppm "(${_c}-${_b})*1000000/${_b}")
  math(EXPR _bp "${_ppm}/100")
  message(STATUS "${B_${_key}_NAME}: real_time ${_b} -> ${_c} micro-units; change=${_bp} bp")
  # Convert user percent to basis points with a string-safe fixed point path.
  _scale_decimal(_limit_scaled "${MAX_REGRESSION_PERCENT}")
  math(EXPR _limit_bp "${_limit_scaled}/10000")
  if(_bp GREATER _limit_bp)
    set(_failed TRUE)
  endif()
endforeach()
if(_failed)
  message(FATAL_ERROR "Google Benchmark regression exceeds MAX_REGRESSION_PERCENT=${MAX_REGRESSION_PERCENT}")
endif()
