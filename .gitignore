# Build trees and generated artifacts (root-anchored so cmake/boilerplate/build/ is tracked).
/out/
/build/
/release_build/
/cmake-build-*/
/CMakeUserPresets.json
/CMakeSettings.json.user
/CMakeFiles/
/CMakeCache.txt
/compile_commands.json
/install/
/doxygen_output/
/docs/doxygen_output/
/scripts/out/

# Local patch exports; keep documented experiment patches under docs/.
/DagFlow-*.patch

# Local tooling state
/.idea/
/.vscode/
/.qtcreator/
/.cache/
/.vs/
**/__pycache__/
*.pyc

# Compiled objects / executables outside the build tree
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dll
*.dylib
*.exe
*.out
*.pdb
*.gcda
*.gcno
*.profraw
*.profdata

# Optional adjacent checkout
/cmake_boilerplate/
