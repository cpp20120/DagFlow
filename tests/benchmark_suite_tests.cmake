set(INVALID_EXIT_CODE 1)
include("${CMAKE_CURRENT_LIST_DIR}/JsonChecks.cmake")
run_json(names --list)
list(LENGTH names count)
set(unique ${names})
list(REMOVE_DUPLICATES unique)
list(LENGTH unique unique_count)
if(NOT count EQUAL 14 OR NOT unique_count EQUAL 14)
  message(FATAL_ERROR "Expected 14 distinct runtime scenarios: ${names}")
endif()
foreach(workers 1 2)
  foreach(tasks 1 65 513)
    foreach(latency OFF ON)
      set(extra)
      if(latency)
        set(extra --latency)
      endif()
      run_json(rows --workers ${workers} --tasks ${tasks} --iterations 3 --repeats 2
        --warmup 1 --sample-stride 4 --idle-us 100 ${extra})
      list(LENGTH rows count)
      if(NOT count EQUAL 14)
        message(FATAL_ERROR "Missing scenario results")
      endif()
      set(index 0)
      foreach(row IN LISTS rows)
        list(GET names ${index} scenario)
        math(EXPR index "${index}+1")
        check_field("${row}" "${scenario}" scenario)
        check_field("${row}" 1 schema)
        if(workers EQUAL 1 AND scenario STREQUAL "steal_heavy")
          check_field("${row}" skipped status)
          continue()
        endif()
        check_field("${row}" ok status)
        string(JSON samples LENGTH "${row}" run_us)
        if(NOT samples EQUAL 2)
          message(FATAL_ERROR "Expected two timing samples")
        endif()
        string(JSON first GET "${row}" run_us 0)
        string(JSON second GET "${row}" run_us 1)
        if(first LESS_EQUAL 0 OR second LESS_EQUAL 0)
          message(FATAL_ERROR "Nonpositive timing sample")
        endif()
        if(first GREATER second)
          set(low "${second}")
          set(high "${first}")
        else()
          set(low "${first}")
          set(high "${second}")
        endif()
        check_field("${row}" "${low}" run_p50_us)
        check_field("${row}" "${high}" run_p999_us)
        string(JSON p99 GET "${row}" run_p99_us)
        string(JSON rate GET "${row}" payload_tasks_per_second)
        if(p99 LESS low OR p99 GREATER high OR NOT rate GREATER 0)
          message(FATAL_ERROR "Invalid percentile ordering or throughput")
        endif()
        if(latency)
          math(EXPR expected "2*((${tasks}-1)/4+1)")
          check_field("${row}" "${expected}" latency_samples)
          string(JSON p50 GET "${row}" latency_p50_us)
          string(JSON p99 GET "${row}" latency_p99_us)
          string(JSON p999 GET "${row}" latency_p999_us)
          if(p50 LESS 0 OR p99 LESS p50 OR p999 LESS p99)
            message(FATAL_ERROR "Invalid latency percentile ordering")
          endif()
        else()
          check_field("${row}" 0 latency_samples)
          string(JSON type TYPE "${row}" latency_p50_us)
          if(NOT type STREQUAL "NULL")
            message(FATAL_ERROR "Latency must be null when not measured")
          endif()
        endif()
        string(JSON checksum GET "${row}" checksum)
        set(uneven FALSE)
        if(scenario STREQUAL "uneven")
          set(uneven TRUE)
        endif()
        check_checksum("${tasks}_${uneven}" "${checksum}")
      endforeach()
    endforeach()
  endforeach()
endforeach()
run_json(row --scenario local_saturated --workers 1 --tasks 20000 --repeats 1 --warmup 0)
check_field("${row}" ok status)
check_field("${row}" 20000 tasks)
foreach(shards 1 5)
  run_json(rows --workers 2 --shards ${shards} --tasks 65 --repeats 1 --warmup 0)
  list(LENGTH rows count)
  if(NOT count EQUAL 14)
    message(FATAL_ERROR "Missing sharded scenarios")
  endif()
  foreach(row IN LISTS rows)
    check_field("${row}" ok status)
    check_field("${row}" "${shards}" shards)
  endforeach()
endforeach()
foreach(workers 1 4)
  foreach(batch 1 4 16 64)
    run_json(row --scenario external_detached --workers ${workers} --submit-batch ${batch}
      --central-batch 4 --tasks 137 --iterations 3 --latency --sample-stride 1 --repeats 2 --warmup 0)
    check_field("${row}" "${batch}" submit_batch)
    check_field("${row}" 4 central_batch)
    check_field("${row}" 274 latency_samples)
    string(JSON checksum GET "${row}" checksum)
    check_checksum(batch "${checksum}")
  endforeach()
endforeach()
check_invalid(--workers 0)
check_invalid(--repeats 0)
check_invalid(--tasks -1)
check_invalid(--submit-batch 65)
check_invalid(--central-batch 0)
check_invalid(--scenario invalid)
check_invalid(--tasks)
check_invalid(--sample-stride 0)
check_invalid(--workers 4294967296)
check_invalid(--work-ns junk)
message(STATUS "Runtime scenario, JSON schema and CLI checks passed")
