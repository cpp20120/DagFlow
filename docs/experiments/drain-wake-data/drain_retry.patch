+  /// Owner only. Publish all values with one bottom release. No value becomes
+  /// stealable before every slot is initialized. Thieves can only increase
+  /// capacity during this operation; the owner must not reenter before return.
+  [[nodiscard]] bool try_push_batch(std::span<const T> values) noexcept {
+    if (values.empty()) return true;
+    const auto b = bottom_.load(std::memory_order_relaxed);
+    const auto t = top_.load(std::memory_order_acquire);
+    if (values.size() > N - static_cast<std::size_t>(b - t)) return false;
+    for (std::size_t i = 0; i < values.size(); ++i)
+      buffer_[(static_cast<std::size_t>(b) + i) & (N - 1)].store(
+          values[i], std::memory_order_relaxed);
+    bottom_.store(b + static_cast<difference_type>(values.size()),
+                  std::memory_order_release);
     return true;
   }
 
